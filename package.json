{
    "name": "aura",
    "productName": "Aura",
    "version": "2.0.1",
    "description": "Aura — darmowa wyspa u góry ekranu Windowsa: muzyka, półka, schowek, widżety, przypomnienia i szkło na żywo.",
    "author": "FameFabricators",
    "license": "MIT",
    "private": true,
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win nsis"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/manrope": "^5.3.0",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "electron": "^45.4.1",
        "electron-builder": "^26.18.0"
    },
    "build": {
        "appId": "pl.aura.app",
        "productName": "Aura",
        "asar": false,
        "directories": {
            "output": "dist"
        },
        "files": [
            "**/*",
            "!docs/**",
            "!dist/**",
            "!scratch/**",
            "!.impeccable/**",
            "!make-icon.js",
            "!**/*.md"
        ],
        "win": {
            "target": "nsis",
            "icon": "icon.ico",
            "artifactName": "Aura-Setup-${version}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "shortcutName": "Aura",
            "runAfterFinish": true
        }
    }
}
